# 画面のビルド時に使う値。Firebase コンソールの「プロジェクトの設定 → マイアプリ」に表示される。
# これらは秘密ではない（公開されるサイトの中に入る）が、リポジトリには書かず、
# GitHub の Variables か、手元の .env.local に置く。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ログイン ID の後ろに付けるドメイン（ID「taro」は taro@<ここ> として認証する）
VITE_LOGIN_DOMAIN=example.com

# アカウントの表示名（キー:表示名 をカンマ区切り）
VITE_ACCOUNT_LABELS=

# 1 にすると Firebase を使わず、public/mock/db.json の模擬データで表示する
VITE_MOCK=
